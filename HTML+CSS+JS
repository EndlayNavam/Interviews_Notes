<script>
const qaData = {
  html: [
    { q: "What is the difference between <div> and <span>?", a: "<div> is a block-level element — it starts on a new line and takes up full width. <span> is an inline element — it sits within text flow. Use <div> for layout sections, <span> for styling a piece of text." },
    { q: "What is the difference between <strong> and <b>?", a: "<strong> has semantic meaning — it marks text as important (useful for screen readers, SEO). <b> is purely presentational bold styling. Prefer <strong> for meaningful emphasis." },
    { q: "What are data attributes in HTML?", a: "Custom attributes prefixed with 'data-' let you store extra info on elements. Example: <div data-user-id='123'>. Access in JS via: element.dataset.userId. Used for attaching metadata without misusing standard attributes." },
    { q: "What is the difference between id and class?", a: "id must be unique — only one element can have a given id per page. class can be reused on multiple elements. Use id for unique elements (header, modal), class for reusable styles and groups." },
    { q: "What is the purpose of <meta> tags?", a: "Meta tags provide metadata about the HTML document — charset (character encoding), viewport (responsive behaviour), description (SEO snippet), keywords, author, and Open Graph tags for social sharing previews." },
    { q: "What is the difference between GET and POST in forms?", a: "GET appends data to the URL (visible, bookmarkable, cached, max ~2000 chars). POST sends data in the request body (not visible in URL, no size limit, used for sensitive or large data like passwords or file uploads)." },
    { q: "What is semantic HTML and why is it important?", a: "Semantic HTML uses tags that describe their meaning (<article>, <nav>, <header>, etc.) rather than generic containers. It improves: (1) Accessibility — screen readers navigate by landmarks. (2) SEO — search engines understand content structure. (3) Maintainability — code is self-documenting." },
  ],
  css: [
    { q: "What is the CSS Box Model?", a: "Every element is a box consisting of (inside out): Content → Padding → Border → Margin. With box-sizing: content-box (default), width refers to content only. With box-sizing: border-box, width includes padding and border — this is recommended for predictable layouts." },
    { q: "What is CSS specificity?", a: "Specificity determines which CSS rule wins when multiple rules target the same element. Priority order: !important > inline styles > ID selectors > Class/pseudo-class/attribute selectors > Element selectors > Universal selector. Calculated as (inline, id, class, element) counts." },
    { q: "What is the difference between visibility: hidden and display: none?", a: "visibility: hidden hides the element but it still occupies space in the layout. display: none removes it from the layout completely — no space, no rendering. A third option is opacity: 0, which makes it invisible but still takes space and remains interactive." },
    { q: "What is the difference between Flexbox and Grid?", a: "Flexbox is 1-dimensional — it lays items along a single axis (row OR column) and is best for components like navbars, button groups, card rows. CSS Grid is 2-dimensional — controls rows AND columns simultaneously, best for full page layouts and complex positioning." },
    { q: "What is z-index and when does it work?", a: "z-index controls stacking order along the Z-axis (which element appears on top). It only works on positioned elements (position: relative, absolute, fixed, sticky). Higher z-index = closer to viewer. Elements in the same stacking context compete against each other." },
    { q: "What are CSS pseudo-elements vs pseudo-classes?", a: "Pseudo-classes target an element's state: :hover, :focus, :first-child, :nth-child(). Pseudo-elements create virtual sub-elements: ::before (insert content before), ::after (after), ::placeholder (style placeholder text), ::selection (highlight color). Pseudo-classes use : and pseudo-elements use ::." },
    { q: "What is the difference between em, rem, px, vw/vh?", a: "px — absolute pixels. em — relative to the parent element's font-size (compounds). rem — relative to root (<html>) font-size (default 16px); more predictable than em. vw/vh — percentage of viewport width/height (100vw = full width). Use rem for typography, % or vw for responsive layouts." },
  ],
  js: [
    { q: "What is the difference between == and ===?", a: "== is loose equality — compares values after type coercion (0 == '0' is true, null == undefined is true). === is strict equality — compares value AND type with no coercion (0 === '0' is false). Always prefer === to avoid unexpected coercion bugs." },
    { q: "What is a closure?", a: "A closure is a function that has access to variables from its outer (enclosing) scope even after that outer function has returned. Example: a counter factory returns an inner function that remembers and increments the count variable. Used for data encapsulation and factory functions." },
    { q: "What is the difference between null and undefined?", a: "undefined means a variable has been declared but not assigned a value — it's the default empty state. null is an explicit assignment meaning 'no value' or 'empty object'. typeof undefined === 'undefined', but typeof null === 'object' (a legacy JS bug)." },
    { q: "Explain event bubbling and event delegation.", a: "Bubbling: when an event fires on an element, it propagates up through ancestors to document. Delegation: attach ONE listener to a parent, and use event.target to determine which child was clicked. Efficient for large lists — no need to attach listeners to each item, also works for dynamically added elements." },
    { q: "What is the difference between let, var, and const?", a: "var is function-scoped and hoisted (initialized as undefined). let and const are block-scoped and in the Temporal Dead Zone before declaration. const cannot be reassigned (but object/array contents can still be mutated). Prefer const by default, use let when you need to reassign." },
    { q: "What is a Promise? What are its states?", a: "A Promise represents an eventual completion or failure of an async operation. States: Pending (initial), Fulfilled (resolved successfully), Rejected (failed). Methods: .then() for success, .catch() for errors, .finally() for cleanup. async/await is syntactic sugar that makes Promises read like synchronous code." },
    { q: "What is the Event Loop in JavaScript?", a: "JS is single-threaded. The Call Stack executes code. Async tasks (fetch, setTimeout) are offloaded to Web APIs. On completion, their callbacks enter the Callback Queue (macrotasks) or Microtask Queue (Promise callbacks). The Event Loop pushes from microtask queue first, then macro, when the Call Stack is empty." },
    { q: "What is the difference between map(), filter(), and forEach()?", a: "map() transforms each element and returns a NEW array of same length. filter() tests each element and returns a NEW array with only passing elements. forEach() iterates for side effects and returns undefined — it does NOT create a new array. map and filter are pure (no mutation); forEach is for side effects." },
    { q: "What is 'this' in JavaScript?", a: "this refers to the context in which a function is called. In global scope: window (browser). In an object method: the object. In a regular function: undefined (strict mode) or window. In an arrow function: inherits from enclosing scope — arrow functions have NO own this. In a class: the instance." },
  ]
};

function buildQA() {
  ['html','css','js'].forEach(type => {
    const container = document.getElementById('qa-' + type);
    qaData[type].forEach((item, i) => {
      const div = document.createElement('div');
      div.className = 'qa-item';
      div.innerHTML = `
        <div class="qa-q" onclick="toggleQA(this)">
          <span>Q${i+1}. ${item.q}</span>
          <span class="arrow">›</span>
        </div>
        <div class="qa-a">${item.a}</div>
      `;
      container.appendChild(div);
    });
  });
}

function toggleQA(el) {
  el.classList.toggle('open');
  el.nextElementSibling.classList.toggle('open');
}

function switchTab(name, btn) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('tab-' + name).classList.add('active');
  btn.classList.add('active');
}

function toggleSection(header) {
  header.classList.toggle('open');
  header.nextElementSibling.classList.toggle('open');
}

buildQA();
</script>
