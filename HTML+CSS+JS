<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>HTML, CSS & JS — Placement Notes</title>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet"/>
<style>
  :root {
    --bg: #0d0d0f;
    --surface: #16161a;
    --surface2: #1e1e24;
    --border: #2a2a35;
    --accent: #7c6af7;
    --accent2: #38d9a9;
    --accent3: #f7c948;
    --text: #e8e6f0;
    --muted: #8884a0;
    --code-bg: #111118;
    --html: #e06c4a;
    --css: #4fa9ff;
    --js: #f7c948;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: 'Syne', sans-serif; min-height: 100vh; }

  /* HEADER */
  .header {
    background: linear-gradient(135deg, #1a1730 0%, #0d1a14 50%, #1a1508 100%);
    border-bottom: 1px solid var(--border);
    padding: 2.5rem 2rem 2rem;
    position: sticky; top: 0; z-index: 100;
  }
  .header-inner { max-width: 960px; margin: 0 auto; }
  .badge { display: inline-flex; align-items: center; gap: 6px; background: rgba(124,106,247,0.15); border: 1px solid rgba(124,106,247,0.3); color: var(--accent); font-size: 11px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; padding: 4px 12px; border-radius: 20px; margin-bottom: 12px; }
  .header h1 { font-size: 1.9rem; font-weight: 800; letter-spacing: -0.5px; line-height: 1.2; }
  .header h1 span.html { color: var(--html); }
  .header h1 span.css { color: var(--css); }
  .header h1 span.js { color: var(--js); }
  .header-meta { margin-top: 10px; font-size: 13px; color: var(--muted); display: flex; gap: 20px; flex-wrap: wrap; align-items: center; }
  .header-meta span { display: flex; align-items: center; gap: 5px; }

  /* TAB NAV */
  .tabs { display: flex; gap: 4px; margin-top: 18px; border-bottom: 1px solid var(--border); padding-bottom: 0; }
  .tab-btn {
    padding: 8px 18px; font-family: 'Syne', sans-serif; font-size: 13px; font-weight: 600;
    background: transparent; border: none; border-bottom: 2px solid transparent;
    color: var(--muted); cursor: pointer; transition: all 0.2s; border-radius: 6px 6px 0 0;
    letter-spacing: 0.3px;
  }
  .tab-btn:hover { color: var(--text); background: rgba(255,255,255,0.04); }
  .tab-btn.active { color: var(--text); border-bottom: 2px solid var(--accent); }
  .tab-btn.html-tab.active { border-color: var(--html); color: var(--html); }
  .tab-btn.css-tab.active { border-color: var(--css); color: var(--css); }
  .tab-btn.js-tab.active { border-color: var(--js); color: var(--js); }

  /* CONTENT */
  .content { max-width: 960px; margin: 0 auto; padding: 2rem; }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* SECTION */
  .section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    margin-bottom: 1.5rem;
    overflow: hidden;
  }
  .section-header {
    display: flex; align-items: center; gap: 12px;
    padding: 1rem 1.25rem; cursor: pointer;
    border-bottom: 1px solid transparent;
    transition: background 0.2s;
    user-select: none;
  }
  .section-header:hover { background: rgba(255,255,255,0.03); }
  .section-header.open { border-bottom-color: var(--border); }
  .section-num {
    width: 28px; height: 28px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700; flex-shrink: 0;
  }
  .html-num { background: rgba(224,108,74,0.15); color: var(--html); }
  .css-num { background: rgba(79,169,255,0.15); color: var(--css); }
  .js-num { background: rgba(247,201,72,0.15); color: var(--js); }
  .section-title { font-size: 15px; font-weight: 700; flex: 1; }
  .section-arrow { color: var(--muted); font-size: 18px; transition: transform 0.25s; }
  .section-header.open .section-arrow { transform: rotate(90deg); }
  .section-body { padding: 1.25rem; display: none; }
  .section-body.open { display: block; }

  /* CONTENT ELEMENTS */
  .intro-text { font-size: 14px; color: var(--muted); line-height: 1.7; margin-bottom: 1.2rem; border-left: 3px solid var(--accent); padding-left: 12px; }
  .intro-text.html-border { border-color: var(--html); }
  .intro-text.css-border { border-color: var(--css); }
  .intro-text.js-border { border-color: var(--js); }

  h3 { font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--muted); margin: 1.2rem 0 0.7rem; }
  h3:first-child { margin-top: 0; }

  ul { list-style: none; display: flex; flex-direction: column; gap: 6px; }
  ul li { font-size: 14px; line-height: 1.6; padding-left: 18px; position: relative; color: var(--text); }
  ul li::before { content: '›'; position: absolute; left: 0; color: var(--accent); font-weight: 700; }

  /* Interview Q&A */
  .qa-block { margin-top: 1rem; }
  .qa-item { margin-bottom: 10px; background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  .qa-q { padding: 10px 14px; font-size: 13px; font-weight: 600; color: var(--accent2); cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
  .qa-q:hover { background: rgba(56,217,169,0.05); }
  .qa-q .arrow { transition: transform 0.2s; color: var(--muted); font-size: 14px; }
  .qa-q.open .arrow { transform: rotate(90deg); }
  .qa-a { display: none; padding: 10px 14px 12px; font-size: 13px; line-height: 1.7; color: var(--muted); border-top: 1px solid var(--border); }
  .qa-a.open { display: block; }

  /* Code */
  code { font-family: 'JetBrains Mono', monospace; font-size: 12px; background: var(--code-bg); border: 1px solid var(--border); padding: 2px 6px; border-radius: 4px; color: var(--accent3); }
  pre { background: var(--code-bg); border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin: 0.8rem 0; overflow-x: auto; }
  pre code { background: transparent; border: none; padding: 0; font-size: 12.5px; color: #c9d1d9; line-height: 1.6; }
  .kw { color: #c792ea; } .fn { color: #82aaff; } .str { color: #c3e88d; }
  .cm { color: #546e7a; font-style: italic; } .num { color: #f78c6c; }
  .tag { color: var(--html); } .attr { color: var(--css); } .val { color: var(--js); }

  /* Tags / chips */
  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }
  .chip { font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; letter-spacing: 0.3px; }
  .chip-purple { background: rgba(124,106,247,0.15); color: var(--accent); border: 1px solid rgba(124,106,247,0.25); }
  .chip-green { background: rgba(56,217,169,0.12); color: var(--accent2); border: 1px solid rgba(56,217,169,0.25); }
  .chip-yellow { background: rgba(247,201,72,0.12); color: var(--js); border: 1px solid rgba(247,201,72,0.25); }
  .chip-red { background: rgba(224,108,74,0.12); color: var(--html); border: 1px solid rgba(224,108,74,0.25); }
  .chip-blue { background: rgba(79,169,255,0.12); color: var(--css); border: 1px solid rgba(79,169,255,0.25); }

  /* Table */
  table { width: 100%; border-collapse: collapse; font-size: 13px; margin: 0.8rem 0; }
  th { background: var(--code-bg); color: var(--muted); font-weight: 700; text-align: left; padding: 8px 12px; border: 1px solid var(--border); font-size: 11px; letter-spacing: 0.8px; text-transform: uppercase; }
  td { padding: 7px 12px; border: 1px solid var(--border); line-height: 1.5; vertical-align: top; }
  tr:nth-child(even) td { background: rgba(255,255,255,0.02); }

  /* Tip box */
  .tip { background: rgba(247,201,72,0.07); border: 1px solid rgba(247,201,72,0.25); border-radius: 8px; padding: 10px 14px; font-size: 13px; color: #e8d99a; margin: 0.8rem 0; line-height: 1.6; }
  .tip strong { color: var(--js); }

  /* Divider */
  .divider { border: none; border-top: 1px solid var(--border); margin: 1.2rem 0; }

  .overview-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 1.5rem; }
  .ov-card { background: var(--surface2); border: 1px solid var(--border); border-radius: 10px; padding: 1rem 1.1rem; }
  .ov-card .ov-label { font-size: 11px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 6px; }
  .ov-card .ov-val { font-size: 22px; font-weight: 800; }
  .ov-card .ov-sub { font-size: 12px; color: var(--muted); margin-top: 4px; }

  @media (max-width: 600px) {
    .header { padding: 1.5rem 1rem 1rem; }
    .header h1 { font-size: 1.35rem; }
    .content { padding: 1rem; }
    .overview-grid { grid-template-columns: 1fr 1fr; }
    .tabs { gap: 2px; }
    .tab-btn { padding: 7px 10px; font-size: 12px; }
  }
</style>
</head>
